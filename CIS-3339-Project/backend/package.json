{
  "name": "backend",
  "version": "2.0.0",
  "description": "Dataplatform backend API",
  "main": "server.js",
  "scripts": {
    "test": "jest --runInBand",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node scripts/initDb.js",
    "db:reset": "node scripts/initDb.js --reset"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^6.7.0",
    "morgan": "^1.10.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "eslint": "^8.47.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^2.0.22",
    "prettier": "^3.0.2",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup/env.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup/quietLogs.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "testTimeout": 30000
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "prettier"
    ],
    "env": {
      "commonjs": true,
      "es6": true,
      "node": true
    },
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "semi": true,
          "singleQuote": true,
          "trailingComma": "none"
        }
      ],
      "arrow-body-style": "off",
      "prefer-arrow-callback": "off"
    },
    "plugins": [
      "prettier"
    ]
  }
}
